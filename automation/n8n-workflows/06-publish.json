        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "CAROUSEL"
            },
            {
              "name": "children",
              "value": "={{ $json.children }}"
            },
            {
              "name": "caption",
              "value": "={{ $json.caption }}"
            },
