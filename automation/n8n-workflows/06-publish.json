    {
      "parameters": {
        "jsCode": "\nconst prev = $('5초 대기').item.json;\nconst statusCode = $input.first().json.status_code;\nconst finished = statusCode === 'FINISHED';\nconst attempt = finished ? prev.attempt : (prev.attempt || 0) + 1;\nreturn [{ json: {\n  container_id: prev.container_id,\n  row_number: prev.row_number,\n  caption: prev.caption,\n  attempt: attempt,\n  finished: finished,\n} }];\n",
        "mode": "runOnceForAllItems"
      },
