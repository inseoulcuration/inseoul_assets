          ]
        }
      },
      "id": "5f98a27b-9247-4360-96c2-bb22e292960c",
      "name": "Instagram: 이미지 컨테이너 생성",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst responses = $input.all();\nconst ids = responses.map(r => (r.json && r.json.data) ? r.json.data.id : '').filter(Boolean);\nconst rowInfo = $('발행대기 행 찾기').item.json;\nreturn [{ json: { row_number: rowInfo.row_number, caption: rowInfo['캡션'] || '', children: ids.join(',') } }];\n",
        "mode": "runOnceForAllItems"
      },
      "id": "080044ae-40ce-4a95-baab-83b3fb246a62",
      "name": "컨테이너 ID 합치기",
