    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(i => i.json);\nconst target = rows.find(r => String(r['상태'] || '').trim() === '발행대기');\nif (!target) return [];\nreturn [{ json: target }];\n",
        "mode": "runOnceForAllItems"
      },
      "id": "1362d78c-90ca-4b61-a7ee-85b755ea991f",
      "name": "발행대기 행 찾기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst row = $input.first().json;\nconst urls = String(row['렌더URL'] || '').split(',').filter(Boolean);\nreturn urls.map(u => ({ json: { url: u } }));\n",
        "mode": "runOnceForAllItems"
      },
      "id": "06f85005-c94c-4e91-9341-d59fc1fb50cb",
      "name": "이미지 목록 생성",
