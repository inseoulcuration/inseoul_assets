    {
      "parameters": {
        "jsCode": "\nconst c = $input.first().json;\nconst prior = $('컨테이너 ID 합치기').item.json;\nreturn [{ json: {\n  container_id: c.data.id,\n  row_number: prior.row_number,\n  caption: prior.caption,\n  attempt: 0,\n  finished: false,\n} }];\n",
        "mode": "runOnceForAllItems"
      },
