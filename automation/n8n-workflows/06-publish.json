        "method": "POST",
        "url": "https://graph.instagram.com/v23.0/me/media",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $json.url }}"
