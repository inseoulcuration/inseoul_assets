    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(i => i.json);\nconst target = rows.find(r => String(r['상태'] || '').trim() === '생성중' && String(r['원고배치ID'] || '').trim() !== '');\nif (!target) return [];\nreturn [{ json: target }];\n",
        "mode": "runOnceForAllItems"
      },
