      "name": "Anthropic: 결과 다운로드 (raw)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nconst raw = (item && item.data !== undefined) ? item.data : item;\nconst text = typeof raw === 'string' ? raw : JSON.stringify(raw);\nconst lines = text.split('\\n').map(l => l.trim()).filter(Boolean);\nif (!lines.length) { throw new Error('배치 결과가 비어 있습니다 (results_url 응답을 확인하세요)'); }\nconst result = JSON.parse(lines[0]);\nconst blocks = (result.result && result.result.message && result.result.message.content) || [];\nconst textBlocks = blocks.filter(b => b.type === 'text');\nif (!textBlocks.length) { throw new Error('원고 응답에 text 블록이 없습니다'); }\nconst lastText = textBlocks[textBlocks.length - 1].text;\n\nconst between = lastText.split('<<<').pop().split('>>>')[0].trim();\nconst draft = JSON.parse(between);\nconst slides = draft.slides || [];\nconst creditsJoined = slides.map(s => s.photo_credit || '').join(',');\nconst sourcesJoined = slides.map(s => s.photo_source || '').join('\\n');\nconst rowInfo = $('생성중 행 찾기').item.json;\n\nreturn [{ json: {\n  row_number: rowInfo.row_number,\n  draft_json_text: between,\n  caption: draft.caption || '',\n  credits_joined: creditsJoined,\n  sources_joined: sourcesJoined,\n} }];\n",
        "mode": "runOnceForAllItems"
      },
      "id": "be1aa246-3776-424a-87a9-61054c1ee7f2",
      "name": "원고 JSON 추출",
