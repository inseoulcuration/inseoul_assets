        "method": "GET",
        "url": "=https://api.github.com/repos/inseoulcuration/inseoul_assets/contents/rows/{{ $json.row_number }}",
        "options": {}
      },
      "id": "425b4362-327a-4ed4-aefa-46edd98311bc",
      "name": "GitHub: rows/{행번호} 폴더 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst resp = $input.first().json;\nconst list = Array.isArray(resp) ? resp : (Array.isArray(resp.body) ? resp.body : []);\nconst photos = list\n  .filter(f => f && f.name && f.name !== '.gitkeep')\n  .sort((a, b) => a.name.localeCompare(b.name))\n  .map(f => f.download_url)\n  .join(',');\nconst rowInfo = $('검증중 행 찾기').item.json;\nreturn [{ json: { row_number: rowInfo.row_number, photos, has_photos: photos.length > 0 } }];\n",
        "mode": "runOnceForAllItems"
      },
      "id": "8255c18b-da95-4f1a-a02d-91efe804f2e6",
