    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(i => i.json);\nconst target = rows.find(r => String(r['상태'] || '').trim() === '검증중');\nif (!target) return [];\nreturn [{ json: target }];\n",
        "mode": "runOnceForAllItems"
      },
      "id": "a5b66646-777b-41a5-9835-c2405c6dda48",
      "name": "검증중 행 찾기",
