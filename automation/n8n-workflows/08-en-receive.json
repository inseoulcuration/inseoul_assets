    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(i => i.json);\nconst target = rows.find(r =>\n  String(r['EN배치ID'] || '').trim() !== '' &&\n  String(r['EN원고JSON'] || '').trim() === ''\n);\nif (!target) return [];\nreturn [{ json: target }];\n",
